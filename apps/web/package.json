{
	"name": "@atlantis/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "wrangler deploy",
		"deploy:dry-run": "wrangler deploy --dry-run",
		"preview": "vite preview",
		"playwright": "bunx playwright test",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test": "vitest run",
		"test:e2e": "bun run playwright test",
		"test:e2e:headed": "bun run playwright test --headed",
		"typecheck": "bun run check",
		"db:generate": "drizzle-kit generate",
		"d1:migrations:list": "wrangler d1 migrations list atlantis-db",
		"d1:migrations:apply:local": "wrangler d1 migrations apply atlantis-db --local",
		"d1:migrations:apply:remote": "wrangler d1 migrations apply atlantis-db --remote",
		"d1:list": "wrangler d1 list",
		"d1:execute": "wrangler d1 execute atlantis-db"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260924.1",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "1.52.0",
		"@sveltejs/adapter-cloudflare": "8.0.0-next.7",
		"@sveltejs/kit": "3.0.0-next.27",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.15.17",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.137.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.33.0",
		"better-sqlite3": "^12.6.2",
		"chart.js": "^4.4.9",
		"chartjs-plugin-annotation": "^3.1.0",
		"drizzle-orm": "^0.45.2",
		"runed": "^0.36.0",
		"zod": "^4.3.6"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#db": {
			"atlantis-d1": "./src/lib/server/db/d1.ts",
			"default": "./src/lib/server/db/sqlite.ts"
		}
	}
}

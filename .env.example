# Copy this file to .env. The web application reads it.
# The pipeline reads the process environment, not this file.
# Dataset input paths and pipeline output paths belong in datasets.json.

# The web application uses this dataset when a route does not select one.
DEFAULT_DATASET=uoregon

# The dataset registry can be at a different location.
# DATASETS_CONFIG_PATH=./datasets.json

# ATLANTIS_DB_DRIVER selects the web database driver when the dashboard starts or builds.
# Set it in the shell, not in this file. See docs/code/development.md.

# Set one database path or use automatic discovery at data/*/netflow.sqlite.
# LOCAL_SQLITE_PATH=/absolute/path/to/netflow.sqlite
# DATABASE_PATH=/absolute/path/to/netflow.sqlite
# Or discover */netflow.sqlite under another directory instead of data/.
# LOCAL_DATA_DIR=/absolute/path/to/data
